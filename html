<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>DeepScan — Real Deepfake Detector (SightEngine)</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔍</text></svg>"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css"/>
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #0a0c12;
    --panel: #12151f;
    --panel2: #1a1e2e;
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.14);
    --text: #e2e8f0;
    --muted: #8896a8;
    --hint: #4a5568;
    --red: #e84855;
    --red-dim: rgba(232,72,85,0.12);
    --green: #4caf82;
    --green-dim: rgba(76,175,130,0.12);
    --amber: #f0a430;
    --amber-dim: rgba(240,164,48,0.1);
    --blue: #4a9eff;
    --blue-dim: rgba(74,158,255,0.1);
    --radius: 10px;
    --radius-sm: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.5;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    flex-wrap: wrap;
    gap: 12px;
  }
  .brand {
    font-family: 'Space Mono', monospace;
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 2px;
  }
  .brand span { color: var(--red); }
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  .container { max-width: 1100px; margin: 0 auto; padding: 32px 24px 80px; }
  .grid { display: grid; grid-template-columns: 1fr 320px; gap: 24px; align-items: start; }
  @media(max-width: 768px){ .grid { grid-template-columns: 1fr; } }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 16px;
  }
  .card-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .api-block {
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    margin-bottom: 12px;
  }
  .api-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .api-name { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 6px; }
  .badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }
  .badge-free { background: var(--green-dim); color: var(--green); }
  .api-input {
    width: 100%;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    font-size: 12px;
    font-family: 'Space Mono', monospace;
    color: var(--text);
    outline: none;
    margin-bottom: 8px;
    transition: 0.2s;
  }
  .api-input:focus { border-color: var(--blue); }
  .api-hint { font-size: 11px; color: var(--muted); line-height: 1.5; }
  .api-hint a { color: var(--blue); text-decoration: none; }
  .api-hint a:hover { text-decoration: underline; }

  .save-btn {
    width: 100%;
    padding: 11px;
    background: transparent;
    border: 1px solid var(--border2);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    cursor: pointer;
    transition: 0.2s;
    margin-top: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .save-btn:hover { border-color: var(--blue); color: var(--blue); }

  .upload-zone {
    border: 1.5px dashed var(--border2);
    border-radius: var(--radius);
    padding: 40px 24px;
    text-align: center;
    cursor: pointer;
    transition: 0.25s;
    background: var(--panel2);
    margin-bottom: 14px;
  }
  .upload-zone:hover, .upload-zone.drag {
    border-color: var(--blue);
    background: var(--blue-dim);
  }
  .upload-icon { font-size: 36px; color: var(--muted); margin-bottom: 10px; }
  .upload-title { font-size: 15px; font-weight: 500; margin-bottom: 4px; }
  .upload-sub { font-size: 12px; color: var(--muted); }
  #file-input { display: none; }

  .preview-box {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 14px;
    display: none;
  }
  .preview-box.show { display: block; }
  .preview-box img, .preview-box video {
    width: 100%;
    max-height: 220px;
    object-fit: cover;
    display: none;
    background: #000;
  }
  .preview-meta {
    padding: 10px 14px;
    font-size: 11px;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
    background: var(--panel2);
    display: flex;
    justify-content: space-between;
  }

  .scan-btn {
    width: 100%;
    padding: 14px;
    background: var(--red);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    display: none;
    transition: 0.2s;
    letter-spacing: 0.5px;
  }
  .scan-btn.show { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .scan-btn:hover { background: #c73040; }
  .scan-btn:disabled { background: var(--hint); cursor: not-allowed; }

  .scanning-block { display: none; text-align: center; padding: 32px 0; }
  .scanning-block.show { display: block; }
  .spinner {
    width: 40px; height: 40px;
    border: 2.5px solid var(--border2);
    border-top-color: var(--red);
    border-radius: 50%;
    margin: 0 auto 16px;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .step-item { font-size: 11px; font-family: 'Space Mono', monospace; padding: 4px 0; transition: 0.3s; }
  .step-item.done { color: var(--green); }
  .step-item.active { color: var(--red); }
  .step-item.pending { color: var(--hint); }

  .notice {
    background: var(--amber-dim);
    border: 1px solid rgba(240,164,48,0.25);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-size: 12px;
    color: var(--amber);
    line-height: 1.6;
    margin-top: 14px;
  }

  /* RIGHT PANEL RESULTS */
  .right-panel { position: sticky; top: 88px; }
  .empty-state {
    text-align: center;
    padding: 50px 20px;
    color: var(--hint);
  }
  .empty-state i { font-size: 44px; display: block; margin-bottom: 12px; }
  .empty-state p { font-size: 13px; line-height: 1.6; }

  .engine-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--blue-dim);
    color: var(--blue);
    font-weight: 600;
    margin-bottom: 12px;
    font-family: 'Space Mono', monospace;
  }

  .verdict-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 18px;
    margin-bottom: 14px;
    background: var(--panel2);
  }
  .verdict-label { font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px; }
  .verdict-value { font-size: 20px; font-weight: 700; font-family: 'Space Mono', monospace; letter-spacing: 1px; }
  .v-fake { color: var(--red); }
  .v-real { color: var(--green); }
  .v-unsure { color: var(--amber); }

  .conf-bar-bg { height: 5px; background: var(--border2); border-radius: 4px; margin: 12px 0 5px; }
  .conf-bar { height: 100%; border-radius: 4px; transition: width 1s ease; }
  .conf-bar.fake { background: var(--red); }
  .conf-bar.real { background: var(--green); }
  .conf-bar.unsure { background: var(--amber); }
  .conf-info { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); }
  .conf-pct { font-family: 'Space Mono', monospace; font-weight: 700; }

  .metrics-list { margin-bottom: 14px; }
  .metric-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .metric-row:last-child { border-bottom: none; }
  .metric-name { font-size: 12px; color: var(--muted); }
  .metric-val { font-size: 12px; font-family: 'Space Mono', monospace; font-weight: 700; }
  .mv-high { color: var(--red); }
  .mv-med { color: var(--amber); }
  .mv-low { color: var(--green); }

  .findings-list { margin-bottom: 14px; }
  .finding { display: flex; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border); align-items: flex-start; }
  .finding:last-child { border-bottom: none; }
  .f-dot { width: 6px; height: 6px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
  .f-dot.red { background: var(--red); }
  .f-dot.yellow { background: var(--amber); }
  .f-dot.green { background: var(--green); }
  .f-dot.gray { background: var(--hint); }
  .f-text { font-size: 11px; color: var(--muted); line-height: 1.5; }
  .f-text strong { color: var(--text); font-size: 12px; display: block; margin-bottom: 1px; }

  .action-row { display: flex; gap: 8px; margin-top: 12px; }
  .act-btn {
    flex: 1;
    padding: 10px 0;
    border: 1px solid var(--border2);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    transition: 0.2s;
    font-family: 'DM Sans', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .act-btn:hover { border-color: var(--blue); color: var(--blue); }

  footer {
    text-align: center;
    padding: 24px;
    font-size: 11px;
    color: var(--hint);
    border-top: 1px solid var(--border);
    margin-top: 40px;
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">DEEP<span>SCAN</span></div>
  <div class="status-indicator">
    <div class="status-dot"></div>
    <span id="statusLabel">Ready — add SightEngine keys</span>
  </div>
</div>

<div class="container">
  <div class="grid">

    <!-- LEFT PANEL -->
    <div>
      <div class="card">
        <div class="card-title">Detection engine</div>
        <div style="font-size:12px; color:var(--blue); margin-bottom:12px;">🔍 SightEngine (real API) · Images only</div>
      </div>

      <div class="upload-zone" id="dropzone" onclick="document.getElementById('file-input').click()">
        <div class="upload-icon"><i class="ti ti-cloud-upload"></i></div>
        <div class="upload-title">Drop image here</div>
        <div class="upload-sub">JPG · PNG · WEBP &nbsp;|&nbsp; max 25 MB</div>
      </div>
      <input type="file" id="file-input" accept="image/*" />

      <div class="preview-box" id="previewBox">
        <img id="prevImg" />
        <div class="preview-meta">
          <span id="prevName">—</span>
          <span id="prevSize">—</span>
        </div>
      </div>

      <button class="scan-btn" id="scanBtn" onclick="startScan()">
        <i class="ti ti-scan"></i> Run deepfake analysis
      </button>

      <div class="scanning-block" id="scanningBlock">
        <div class="spinner"></div>
        <div>
          <div class="step-item pending" id="step1">[ 1/3 ] Preparing image...</div>
          <div class="step-item pending" id="step2">[ 2/3 ] Calling SightEngine API...</div>
          <div class="step-item pending" id="step3">[ 3/3 ] Generating report...</div>
        </div>
      </div>

      <div class="notice">
        <strong>SightEngine free tier</strong> — 500 checks/month. Get your API keys at <a href="https://sightengine.com" target="_blank" style="color:var(--blue);">sightengine.com</a> → Dashboard → API credentials. Then paste below.
      </div>

      <!-- API KEYS (only SightEngine) -->
      <div class="api-block">
        <div class="api-header">
          <div class="api-name"><i class="ti ti-eye"></i> SightEngine API</div>
          <span class="badge badge-free">FREE TIER</span>
        </div>
        <input type="text" class="api-input" id="sight_user" placeholder="api_user" autocomplete="off" />
        <input type="password" class="api-input" id="sight_secret" placeholder="api_secret" autocomplete="off" />
        <div class="api-hint">Your SightEngine API credentials. The free plan gives you 500 image deepfake checks per month.</div>
        <button class="save-btn" onclick="saveKeys()"><i class="ti ti-device-floppy"></i> Save keys</button>
      </div>
    </div>

    <!-- RIGHT PANEL: RESULTS -->
    <div class="right-panel">
      <div class="card" style="min-height: 400px;">
        <div class="card-title">Analysis report</div>
        <div id="emptyState" class="empty-state">
          <i class="ti ti-shield-search"></i>
          <p>Upload an image and run a scan.<br>Real deepfake detection results appear here.</p>
        </div>
        <div id="reportPanel" style="display:none;">
          <div id="engineTagBlock"></div>
          <div class="verdict-card">
            <div class="verdict-label">Verdict</div>
            <div class="verdict-value" id="rVerdict">—</div>
            <div class="conf-bar-bg"><div class="conf-bar" id="confBar" style="width:0%;"></div></div>
            <div class="conf-info">
              <span>Confidence</span>
              <span class="conf-pct" id="confPct">—</span>
            </div>
          </div>
          <div class="card-title">Forensic metrics</div>
          <div class="metrics-list" id="metricsList"></div>
          <div class="card-title">Key findings</div>
          <div class="findings-list" id="findingsList"></div>
          <div class="action-row">
            <button class="act-btn" onclick="downloadReport()"><i class="ti ti-download"></i> Download report</button>
            <button class="act-btn" onclick="resetApp()"><i class="ti ti-refresh"></i> New scan</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<footer>
  DeepScan — Real deepfake detection using SightEngine API. Only detects image-based face-swap deepfakes. Not 100% accurate.
</footer>

<script>
// =================== GLOBALS ===================
let currentFile = null, scanResult = null;
let sightUser = '', sightSecret = '';

// =================== KEY MANAGEMENT ===================
function loadKeys() {
  sightUser = localStorage.getItem('ds_sight_user') || '';
  sightSecret = localStorage.getItem('ds_sight_secret') || '';
  const su = document.getElementById('sight_user');
  const ss = document.getElementById('sight_secret');
  if (su) su.value = sightUser;
  if (ss) ss.value = sightSecret;
  updateStatus();
}

function saveKeys() {
  sightUser = (document.getElementById('sight_user').value || '').trim();
  sightSecret = (document.getElementById('sight_secret').value || '').trim();
  localStorage.setItem('ds_sight_user', sightUser);
  localStorage.setItem('ds_sight_secret', sightSecret);
  updateStatus();
  document.getElementById('statusLabel').textContent = 'Keys saved';
  setTimeout(() => updateStatus(), 1500);
}

function updateStatus() {
  const hasKeys = sightUser && sightSecret;
  document.getElementById('statusLabel').textContent = hasKeys
    ? 'SightEngine ready — upload an image to detect deepfakes'
    : '⚠️ Add SightEngine API keys (free) to enable real detection';
}

// =================== UI HELPERS ===================
function formatSize(b) {
  if (b < 1024) return b + 'B';
  if (b < 1048576) return (b / 1024).toFixed(1) + 'KB';
  return (b / 1048576).toFixed(1) + 'MB';
}

function handleFile(file) {
  if (!file.type.startsWith('image/')) {
    alert('Only images are supported (JPG, PNG, WEBP). Video deepfake detection requires a backend proxy.');
    return;
  }
  currentFile = file;
  document.getElementById('previewBox').classList.add('show');
  const img = document.getElementById('prevImg');
  img.style.display = 'block';
  img.src = URL.createObjectURL(file);
  const name = file.name;
  document.getElementById('prevName').textContent = name.length > 30 ? name.substring(0, 28) + '...' : name;
  document.getElementById('prevSize').textContent = formatSize(file.size);
  document.getElementById('scanBtn').classList.add('show');
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('reportPanel').style.display = 'none';
  document.getElementById('scanningBlock').classList.remove('show');
}

// =================== SIGHTENGINE ANALYSIS (ONLY REAL ENGINE) ===================
async function sightengineAnalyze(file) {
  if (!sightUser || !sightSecret) {
    throw new Error('SightEngine API keys missing — add them in the API section above');
  }
  const fd = new FormData();
  fd.append('media', file);
  fd.append('models', 'deepfake,faces');
  fd.append('api_user', sightUser);
  fd.append('api_secret', sightSecret);
  const res = await fetch('https://api.sightengine.com/1.0/check.json', { method: 'POST', body: fd });
  const data = await res.json();
  if (data.status === 'failure' || data.error) {
    throw new Error(data.error?.message || 'SightEngine API error');
  }
  let score = 50;
  if (data.deepfake?.score != null) score = Math.round(data.deepfake.score * 100);
  else if (data.type?.deepfake != null) score = Math.round(data.type.deepfake * 100);
  score = Math.min(98, Math.max(2, score));
  const verdict = score >= 65 ? 'fake' : (score <= 35 ? 'real' : 'unsure');
  const metrics = [
    { name: 'Deepfake probability', value: score, cls: score > 65 ? 'high' : (score > 40 ? 'med' : 'low') },
    { name: 'Face authenticity', value: 100 - score, cls: (100 - score) > 60 ? 'low' : 'high' },
    { name: 'Visual artifact index', value: Math.min(95, score + 4), cls: score > 60 ? 'high' : 'low' },
  ];
  const signals = [
    { dot: score > 60 ? 'red' : 'green', main: `SightEngine deepfake model: ${score}% probability`, sub: 'Proprietary GAN face detection model — real API result' },
  ];
  if (data.faces?.length > 0) {
    signals.push({ dot: 'gray', main: `${data.faces.length} face(s) detected`, sub: 'Face region analysis completed' });
  } else {
    signals.push({ dot: 'yellow', main: 'No faces detected', sub: 'Deepfake detection works best on images containing human faces' });
  }
  return { verdict, confidence: score, metrics, signals, source: 'SightEngine (real API)' };
}

// =================== LOCAL FALLBACK (LOW ACCURACY) ===================
function heuristicFallback(file) {
  const sizeMB = file.size / 1048576;
  const name = file.name.toLowerCase();
  let score = 30;
  if (sizeMB < 0.08) score += 20;
  if (sizeMB > 8) score -= 10;
  if (file.type === 'image/webp') score += 10;
  if (/deepfake|fake|gan|generated|swap|ai|artificial/.test(name)) score += 25;
  if (/\d{8,}/.test(name) || /output|result|render/.test(name)) score += 8;
  score = Math.min(90, Math.max(10, Math.round(score)));
  const verdict = score >= 65 ? 'fake' : (score <= 35 ? 'real' : 'unsure');
  const metrics = [
    { name: 'Heuristic file score', value: score, cls: score > 65 ? 'high' : (score > 40 ? 'med' : 'low') },
    { name: 'Format risk', value: file.type === 'image/webp' ? 65 : 30, cls: 'med' },
  ];
  const signals = [
    { dot: 'gray', main: '⚠️ No SightEngine API keys — using low-accuracy heuristic only', sub: 'Add free SightEngine keys for real deepfake detection' }
  ];
  if (file.type === 'image/webp') signals.push({ dot: 'yellow', main: 'WebP format — sometimes used for AI images, but not conclusive', sub: '' });
  if (/deepfake|fake|gan|generated/.test(name)) signals.push({ dot: 'red', main: 'Filename contains manipulation keywords', sub: name });
  return { verdict, confidence: score, metrics, signals, source: 'Local Heuristic (low confidence)' };
}

// =================== MASTER ANALYSIS ===================
async function runAnalysis(file) {
  if (sightUser && sightSecret) {
    try {
      return await sightengineAnalyze(file);
    } catch (err) {
      console.warn('SightEngine failed:', err);
      const fallback = heuristicFallback(file);
      fallback.signals.unshift({ dot: 'yellow', main: 'SightEngine error — fell back to heuristic', sub: err.message });
      return fallback;
    }
  } else {
    return heuristicFallback(file);
  }
}

// =================== SCAN FLOW ===================
function setStep(n) {
  const steps = ['step1', 'step2', 'step3'];
  for (let i = 1; i <= 3; i++) {
    const el = document.getElementById('step' + i);
    if (i < n) el.className = 'step-item done';
    else if (i === n) el.className = 'step-item active';
    else el.className = 'step-item pending';
  }
}

async function startScan() {
  if (!currentFile) return;
  const btn = document.getElementById('scanBtn');
  btn.disabled = true;
  btn.classList.remove('show');
  document.getElementById('scanningBlock').classList.add('show');
  document.getElementById('reportPanel').style.display = 'none';
  setStep(1);
  await new Promise(r => setTimeout(r, 200));
  setStep(2);
  let result;
  try {
    result = await runAnalysis(currentFile);
    setStep(3);
    await new Promise(r => setTimeout(r, 300));
  } catch (err) {
    console.error(err);
    result = heuristicFallback(currentFile);
    result.signals.unshift({ dot: 'yellow', main: 'Unexpected error — fallback', sub: err.message });
    setStep(3);
  }
  scanResult = result;
  document.getElementById('scanningBlock').classList.remove('show');
  btn.disabled = false;
  btn.classList.add('show');
  renderReport(result);
}

// =================== RENDER RESULTS ===================
function renderReport(r) {
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('reportPanel').style.display = 'block';
  document.getElementById('engineTagBlock').innerHTML = `<div class="engine-tag"><i class="ti ti-cpu"></i> ${r.source}</div>`;
  const vt = document.getElementById('rVerdict');
  vt.textContent = r.verdict === 'fake' ? 'LIKELY DEEPFAKE' : (r.verdict === 'real' ? 'LIKELY AUTHENTIC' : 'INCONCLUSIVE');
  vt.className = 'verdict-value v-' + r.verdict;
  const bar = document.getElementById('confBar');
  bar.style.width = '0%';
  bar.className = 'conf-bar ' + r.verdict;
  setTimeout(() => bar.style.width = r.confidence + '%', 50);
  document.getElementById('confPct').textContent = r.confidence + '%';
  const ml = document.getElementById('metricsList');
  ml.innerHTML = '';
  (r.metrics || []).forEach(m => {
    const cls = m.cls === 'high' ? 'mv-high' : (m.cls === 'med' ? 'mv-med' : 'mv-low');
    ml.innerHTML += `<div class="metric-row"><span class="metric-name">${m.name}</span><span class="metric-val ${cls}">${Math.round(m.value)}%</span></div>`;
  });
  const fl = document.getElementById('findingsList');
  fl.innerHTML = '';
  (r.signals || []).forEach(s => {
    fl.innerHTML += `<div class="finding"><div class="f-dot ${s.dot || 'gray'}"></div><div class="f-text"><strong>${s.main}</strong>${s.sub ? ' — ' + s.sub : ''}</div></div>`;
  });
}

function downloadReport() {
  if (!scanResult || !currentFile) return;
  const d = new Date().toISOString();
  let t = `DEEPSCAN — DEEPFAKE FORENSIC REPORT\n${'='.repeat(44)}\nGenerated: ${d}\nFile: ${currentFile.name}\nSize: ${formatSize(currentFile.size)}\nType: ${currentFile.type}\n\nVERDICT: ${scanResult.verdict.toUpperCase()}\nCONFIDENCE: ${scanResult.confidence}%\nENGINE: ${scanResult.source}\n\nFORENSIC METRICS:\n`;
  (scanResult.metrics || []).forEach(m => t += `  ${m.name}: ${Math.round(m.value)}%\n`);
  t += `\nKEY FINDINGS:\n`;
  (scanResult.signals || []).forEach(s => t += `• ${s.main}${s.sub ? ' — ' + s.sub : ''}\n`);
  t += `\n${'='.repeat(44)}\nDISCLAIMER: No deepfake detector is 100% accurate. Use as one signal.\nDeepScan — For research and educational use only.`;
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([t], { type: 'text/plain' }));
  a.download = `deepscan_report_${Date.now()}.txt`;
  a.click();
}

function resetApp() {
  currentFile = null; scanResult = null;
  document.getElementById('previewBox').classList.remove('show');
  document.getElementById('scanBtn').classList.remove('show');
  document.getElementById('scanBtn').disabled = false;
  document.getElementById('reportPanel').style.display = 'none';
  document.getElementById('emptyState').style.display = 'block';
  document.getElementById('scanningBlock').classList.remove('show');
  document.getElementById('file-input').value = '';
  document.getElementById('prevImg').src = '';
}

// =================== EVENT LISTENERS ===================
const dz = document.getElementById('dropzone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag'); });
dz.addEventListener('dragleave', () => dz.classList.remove('drag'));
dz.addEventListener('drop', e => {
  e.preventDefault(); dz.classList.remove('drag');
  if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
});
document.getElementById('file-input').addEventListener('change', e => {
  if (e.target.files[0]) handleFile(e.target.files[0]);
});
loadKeys();
</script>
